---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import { siteConfig } from "../data/site";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  wide?: boolean | undefined;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  wide = false,
} = Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "";
const isWriting = pathname.startsWith("/posts");
const isNotes = pathname.startsWith("/notes");
const isProjects = pathname.startsWith("/projects");
const isAbout = pathname.startsWith("/about");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/logo.png" />
  </head>
  <body class={wide ? "layout-wide" : "layout-standard"}>
    <div class="site-container">
      <header id="site-header">
        <div class="header-inner">
          <nav id="navigation">
            <a href="/" class={isHome ? "active" : ""}>Home</a>
            <a href="/posts" class={isWriting ? "active" : ""}>Writing</a>
            <a href="/notes" class={isNotes ? "active" : ""}>Notes</a>
            <a href="/projects" class={isProjects ? "active" : ""}>Projects</a>
            <a href="/about" class={isAbout ? "active" : ""}>About</a>
          </nav>
        </div>
      </header>

      <main id="site-main">
        <slot />
      </main>

      <footer id="site-footer">
        <p>
          © {new Date().getFullYear()} Tran Van Ngoc. Powered by Astro & Second
          Brain.
        </p>
      </footer>
    </div>

    <!-- Minimalist Terminal Image Modal / Lightbox -->
    <div id="image-modal-lightbox" class="image-modal-backdrop" aria-hidden="true">
      <div class="image-modal-content">
        <img id="image-modal-img" src="" alt="Zoomed view" />
        <span class="image-modal-hint">[Click anywhere or press ESC to close]</span>
      </div>
    </div>

    <script is:inline>
      (function initImageLightbox() {
        function setup() {
          const modal = document.getElementById("image-modal-lightbox");
          const modalImg = document.getElementById("image-modal-img");
          if (!modal || !modalImg) return;

          function openModal(src, alt) {
            modalImg.src = src;
            modalImg.alt = alt || "Zoomed view";
            modal.classList.add("open");
            modal.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";
          }

          function closeModal() {
            modal.classList.remove("open");
            modal.setAttribute("aria-hidden", "true");
            modalImg.src = "";
            document.body.style.overflow = "";
          }

          document.addEventListener("click", function(e) {
            var target = e.target;
            if (target && target.tagName === "IMG") {
              if (target.id === "image-modal-img") return;
              if (target.closest(".note-content") || target.closest(".post-content") || target.closest("article") || target.closest("main")) {
                e.preventDefault();
                e.stopPropagation();
                openModal(target.src, target.alt);
              }
            }
          });

          modal.addEventListener("click", closeModal);

          document.addEventListener("keydown", function(e) {
            if (e.key === "Escape" && modal.classList.contains("open")) {
              closeModal();
            }
          });
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", setup);
        } else {
          setup();
        }
      })();
    </script>
  </body>
</html>

<style>
  .site-container {
    width: 100%;
    margin: 0 auto;
    position: relative;
  }

  .header-inner {
    width: 100%;
  }

  #site-main {
    min-height: 60vh;
  }
</style>
