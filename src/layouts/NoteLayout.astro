---
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";

interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string | undefined;
  date?: string | undefined;
  domain?: string | undefined;
  tags?: string[] | undefined;
  headings: HeadingItem[];
}

const {
  title,
  description,
  date,
  domain = "Engineering",
  tags = [],
  headings,
} = Astro.props;

function formatNoteDate(dateStr?: string) {
  if (!dateStr) return "";
  const d = new Date(dateStr);
  const options: Intl.DateTimeFormatOptions = {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  };
  return d.toLocaleDateString("en-US", options);
}
---

<BaseLayout title={`${title} — Second Brain`} description={description}>
  <div class="note-layout-container">
    <article class="note-article">
      <nav class="breadcrumb-nav">
        <a href="/notes" class="back-link">&lt;- Second Brain</a>
        <span class="domain-tag">[{domain}]</span>
      </nav>

      <header class="terminal-note-header">
        <div class="title-bar-wrap">
          <div class="accent-bar"></div>
          <h1 class="note-title">{title}</h1>
        </div>

        <div class="note-meta">
          <span class="meta-author">Tran Van Ngoc</span>
          {
            date && (
              <>
                <span class="meta-divider">|</span>
                <time class="meta-date">{formatNoteDate(date)}</time>
              </>
            )
          }
        </div>

        {
          tags.length > 0 && (
            <div class="note-tags">
              {tags.map((t) => (
                <span class="post-tag">#{t}</span>
              ))}
            </div>
          )
        }
      </header>

      <div class="note-content">
        <slot />
      </div>

      <nav class="note-bottom-nav">
        <a href="/notes" class="back-link">&lt;- Back to Second Brain</a>
        <a href="/notes/graph" class="graph-link">Explore Graph View -&gt;</a>
      </nav>
    </article>

    <div class="toc-outer-rail">
      <TableOfContents headings={headings} />
    </div>
  </div>

  <script is:inline type="module">
    const mermaidBlocks = document.querySelectorAll(
      'pre[data-language="mermaid"], pre.mermaid, code.language-mermaid'
    );
    if (mermaidBlocks.length > 0) {
      import("https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs")
        .then(({ default: mermaid }) => {
          mermaid.initialize({
            startOnLoad: false,
            theme: "dark",
            themeVariables: {
              darkMode: true,
              background: "#1a1a1a",
              primaryColor: "#262626",
              primaryTextColor: "#ffffff",
              primaryBorderColor: "#3d3d3d",
              lineColor: "#888888",
              secondaryColor: "#1e1e1e",
              tertiaryColor: "#141414",
            },
          });

          mermaidBlocks.forEach(async (block, index) => {
            const preElement = block.tagName === "PRE" ? block : block.closest("pre");
            if (!preElement || preElement.dataset.mermaidRendered) return;

            const code = block.textContent?.trim() || "";
            const id = `mermaid-svg-${index}`;
            try {
              const { svg } = await mermaid.render(id, code);
              const container = document.createElement("div");
              container.className = "mermaid-diagram-container";
              container.innerHTML = svg;
              preElement.replaceWith(container);
            } catch (err) {
              console.error("Mermaid render error:", err);
            }
          });
        })
        .catch((err) => console.error("Failed to load Mermaid:", err));
    }
  </script>
</BaseLayout>

<style>
  /* Base content always stays within standard 48rem column */
  .note-layout-container {
    position: relative;
    width: 100%;
    max-width: 48rem;
    margin: 0 auto;
  }

  .note-article {
    width: 100%;
    min-width: 0;
  }

  /* TOC sits gracefully outside to the right on wide desktop screens (>= 1240px) and stays STICKY */
  .toc-outer-rail {
    display: none;
  }

  @media (min-width: 1240px) {
    .toc-outer-rail {
      display: block;
      position: absolute;
      left: calc(100% + 2.5rem);
      top: 0;
      bottom: 0;
      width: 260px;
      pointer-events: none;
    }

    .toc-outer-rail :global(.toc-sidebar) {
      pointer-events: auto;
      position: sticky;
      top: 2rem;
      align-self: flex-start;
      max-height: calc(100vh - 4rem);
      overflow-y: auto;
    }
  }

  .breadcrumb-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    font-family: "JetBrains Mono", Consolas, Menlo, monospace;
    font-size: 0.85rem;
  }

  .back-link {
    color: var(--subheading-color, #888888);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--heading-color, #ffffff);
  }

  .domain-tag {
    color: var(--subheading-color, #888888);
    font-weight: 500;
  }

  .terminal-note-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px dashed var(--border-dotted, #3d3d3d);
  }

  .title-bar-wrap {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .accent-bar {
    width: 3px;
    align-self: stretch;
    background-color: var(--heading-color, #ffffff);
    border-radius: 2px;
    flex-shrink: 0;
  }

  .note-title {
    font-family: "JetBrains Mono", Consolas, Menlo, monospace;
    font-size: 1.85rem;
    font-weight: 700;
    color: var(--heading-color, #ffffff);
    margin: 0;
    line-height: 1.25;
    letter-spacing: -0.01em;
    word-break: break-word;
  }

  @media (max-width: 640px) {
    .note-title {
      font-size: 1.45rem;
    }
    .terminal-note-header {
      margin-bottom: 1.8rem;
      padding-bottom: 1rem;
    }
    .note-meta {
      padding-left: 0.5rem !important;
      font-size: 0.78rem !important;
    }
    .note-tags {
      padding-left: 0.5rem !important;
    }
  }

  .note-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: "JetBrains Mono", Consolas, Menlo, monospace;
    font-size: 0.85rem;
    color: var(--subheading-color, #888888);
    margin-top: 0.5rem;
    padding-left: 1rem;
  }

  .meta-author {
    color: #cccccc;
  }

  .meta-divider {
    color: #555555;
  }

  .note-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.75rem;
    padding-left: 1rem;
    font-size: 0.833rem;
  }

  .post-tag {
    font-family: "JetBrains Mono", Consolas, monospace;
    color: var(--subheading-color);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
    cursor: default;
  }

  .post-tag:hover {
    color: var(--heading-color);
  }

  /* Note content typography matching terminal / clean monochrome aesthetic */
  .note-content {
    line-height: 1.68;
    color: var(--text-color, #dddddd);
    word-break: break-word;
  }

  .note-content :global(h2) {
    font-family: "JetBrains Mono", Consolas, Menlo, monospace;
    font-size: 1.35rem;
    color: #ffffff;
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid #262626;
  }

  .note-content :global(h3) {
    font-family: "JetBrains Mono", Consolas, Menlo, monospace;
    font-size: 1.1rem;
    color: #eeeeee;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  @media (max-width: 640px) {
    .note-content :global(h2) {
      font-size: 1.2rem;
      margin-top: 2rem;
    }
    .note-content :global(h3) {
      font-size: 1.05rem;
      margin-top: 1.5rem;
    }
  }

  .note-content :global(code) {
    font-family: "JetBrains Mono", Consolas, Menlo, monospace;
    font-size: 0.88em;
    background-color: var(--code-bg, #1a1a1a);
    padding: 0.15em 0.35em;
    border-radius: 3px;
    color: var(--code-text, #eeeeee);
    border: 1px solid #282828;
  }

  .note-content :global(pre) {
    background-color: #141414 !important;
    border: 1px solid #282828;
    padding: 1rem;
    border-radius: 4px;
    overflow-x: auto;
  }

  .note-content :global(pre code) {
    background: transparent;
    padding: 0;
    color: inherit;
    border: none;
  }

  .note-content :global(a) {
    color: var(--link-color, #ffffff);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: all 0.15s ease;
  }

  .note-content :global(a:hover) {
    color: var(--link-hover, #ffffff);
  }

  .note-bottom-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--border-dotted, #3d3d3d);
    font-family: "JetBrains Mono", Consolas, Menlo, monospace;
    font-size: 0.88rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .graph-link {
    color: var(--heading-color, #ffffff);
    text-decoration: none;
    font-weight: 500;
  }

  .graph-link:hover {
    text-decoration: underline;
  }

  :global(.mermaid-diagram-container) {
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: var(--code-bg, #1a1a1a);
    border: 1px solid var(--border-color, #2a2a2a);
    border-radius: 4px;
    padding: 1.5rem 1rem;
    margin: 2rem 0;
    overflow-x: auto;
  }

  :global(.mermaid-diagram-container svg) {
    max-width: 100%;
    height: auto;
  }
</style>
