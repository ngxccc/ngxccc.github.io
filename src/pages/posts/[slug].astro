---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

function formatPostDate(dateStr: string) {
  const d = new Date(dateStr);
  const options: Intl.DateTimeFormatOptions = {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  };
  return d.toLocaleDateString("en-US", options);
}
---

<BaseLayout
  title={`${post.data.title} — Tran Van Ngoc`}
  description={post.data.description}
>
  <div class="post-layout-container">
    <article class="post-article">
      <nav class="breadcrumb-nav">
        <a href="/posts" class="back-link">&lt;- Writing</a>
      </nav>

      <header class="terminal-post-header">
        <div class="title-bar-wrap">
          <div class="accent-bar"></div>
          <h1 class="post-title">{post.data.title}</h1>
        </div>

        <div class="post-meta">
          <span class="meta-author">Tran Van Ngoc</span>
          <span class="meta-divider">|</span>
          <time class="meta-date">{formatPostDate(post.data.date)}</time>
        </div>

        {
          post.data.tags.length > 0 && (
            <div class="post-tags">
              {post.data.tags.map((tag: string) => (
                <a href={`/tags/${tag}`} class="post-tag">
                  #{tag}
                </a>
              ))}
            </div>
          )
        }
      </header>

      <div class="post-content">
        <Content />
      </div>

      <nav class="post-bottom-nav">
        <a href="/posts" class="back-link">&lt;- Back to all articles</a>
      </nav>
    </article>

    <div class="toc-outer-rail">
      <TableOfContents headings={headings} />
    </div>
  </div>

  <script is:inline type="module">
    const mermaidBlocks = document.querySelectorAll(
      'pre[data-language="mermaid"], pre.mermaid, code.language-mermaid'
    );
    if (mermaidBlocks.length > 0) {
      import("https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs")
        .then(({ default: mermaid }) => {
          mermaid.initialize({
            startOnLoad: false,
            theme: "dark",
            themeVariables: {
              darkMode: true,
              background: "#1a1a1a",
              primaryColor: "#262626",
              primaryTextColor: "#ffffff",
              primaryBorderColor: "#3d3d3d",
              lineColor: "#888888",
              secondaryColor: "#1e1e1e",
              tertiaryColor: "#141414",
            },
          });

          mermaidBlocks.forEach(async (block, index) => {
            const preElement = block.tagName === "PRE" ? block : block.closest("pre");
            if (!preElement || preElement.dataset.mermaidRendered) return;

            const code = block.textContent?.trim() || "";
            const id = `mermaid-svg-${index}`;
            try {
              const { svg } = await mermaid.render(id, code);
              const container = document.createElement("div");
              container.className = "mermaid-diagram-container";
              container.innerHTML = svg;
              preElement.replaceWith(container);
            } catch (err) {
              console.error("Mermaid render error:", err);
            }
          });
        })
        .catch((err) => console.error("Failed to load Mermaid:", err));
    }
  </script>
</BaseLayout>

<style>
  .post-layout-container {
    position: relative;
    width: 100%;
    max-width: 48rem;
    margin: 0 auto;
  }

  .post-article {
    width: 100%;
    min-width: 0;
  }

  /* TOC sits gracefully outside to the right on wide desktop screens (>= 1240px) and stays STICKY */
  .toc-outer-rail {
    display: none;
  }

  @media (min-width: 1240px) {
    .toc-outer-rail {
      display: block;
      position: absolute;
      left: calc(100% + 2.5rem);
      top: 0;
      bottom: 0;
      width: 260px;
      pointer-events: none;
    }

    .toc-outer-rail :global(.toc-sidebar) {
      pointer-events: auto;
      position: sticky;
      top: 2rem;
      align-self: flex-start;
      max-height: calc(100vh - 4rem);
      overflow-y: auto;
    }
  }

  .breadcrumb-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    font-family: "JetBrains Mono", Consolas, Menlo, monospace;
    font-size: 0.85rem;
  }

  .back-link {
    color: var(--subheading-color, #888888);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--heading-color, #ffffff);
  }

  .terminal-post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px dashed var(--border-dotted, #3d3d3d);
  }

  .title-bar-wrap {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .accent-bar {
    width: 3px;
    align-self: stretch;
    background-color: var(--heading-color, #ffffff);
    border-radius: 2px;
    flex-shrink: 0;
  }

  .post-title {
    font-family: "JetBrains Mono", Consolas, Menlo, monospace;
    font-size: 1.85rem;
    font-weight: 700;
    color: var(--heading-color, #ffffff);
    margin: 0;
    line-height: 1.25;
    letter-spacing: -0.01em;
    word-break: break-word;
  }

  @media (max-width: 640px) {
    .post-title {
      font-size: 1.45rem;
    }
    .terminal-post-header {
      margin-bottom: 1.8rem;
      padding-bottom: 1rem;
    }
    .post-meta {
      padding-left: 0.5rem !important;
      font-size: 0.78rem !important;
    }
    .post-tags {
      padding-left: 0.5rem !important;
    }
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: "JetBrains Mono", Consolas, Menlo, monospace;
    font-size: 0.85rem;
    color: var(--subheading-color, #888888);
    margin-top: 0.5rem;
    padding-left: 1rem;
  }

  .meta-author {
    color: #cccccc;
  }

  .meta-divider {
    color: #555555;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.75rem;
    padding-left: 1rem;
    font-size: 0.833rem;
  }

  .post-tag {
    font-family: "JetBrains Mono", Consolas, monospace;
    color: var(--subheading-color);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
    display: inline-block;
  }

  .post-tag:hover {
    color: var(--heading-color);
  }

  .post-content {
    line-height: 1.68;
    color: var(--text-color, #dddddd);
    word-break: break-word;
  }

  .post-bottom-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--border-dotted, #3d3d3d);
    font-family: "JetBrains Mono", Consolas, Menlo, monospace;
    font-size: 0.88rem;
  }

  :global(.mermaid-diagram-container) {
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: var(--code-bg);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    padding: 1.5rem 1rem;
    margin: 2rem 0;
    overflow-x: auto;
  }

  :global(.mermaid-diagram-container svg) {
    max-width: 100%;
    height: auto;
  }
</style>
