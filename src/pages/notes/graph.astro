---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Knowledge Graph — Second Brain"
  description="Interactive 2D force-directed knowledge graph of connected atomic notes."
>
  <div class="graph-page-container">
    <nav class="breadcrumb-nav">
      <a href="/notes" class="back-link">&lt;- Second Brain Notes</a>
    </nav>

    <header class="graph-header">
      <div class="title-wrap">
        <div class="accent-bar"></div>
        <h1 class="page-title">Knowledge Graph Network</h1>
      </div>
      <p class="tagline">
        Interactive visualization of connections, mental models, and software
        architecture notes. Drag nodes or click to navigate.
      </p>

      <div class="graph-legend">
        <span class="legend-item"><span class="legend-dot engineering"></span> Engineering</span>
        <span class="legend-item"><span class="legend-dot mental-models"></span> Mental Models</span>
        <span class="legend-item"><span class="legend-dot linguistics"></span> Linguistics</span>
        <span class="legend-item"><span class="legend-dot economics"></span> Economics</span>
      </div>
    </header>

    <div class="canvas-wrapper">
      <div id="graph-tooltip" class="graph-tooltip"></div>
      <canvas id="graph-canvas"></canvas>
      <div class="controls-overlay">
        <button id="zoom-in" title="Zoom In">+</button>
        <button id="zoom-out" title="Zoom Out">-</button>
        <button id="reset-zoom" title="Reset View">R</button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  interface GraphNode {
    id: string;
    title: string;
    domain: string;
    url: string;
    x?: number;
    y?: number;
    vx?: number;
    vy?: number;
    radius?: number;
  }

  interface GraphLink {
    source: string | GraphNode;
    target: string | GraphNode;
  }

  interface GraphData {
    nodes: GraphNode[];
    links: GraphLink[];
  }

  async function initGraph() {
    const canvas = document.getElementById("graph-canvas") as HTMLCanvasElement | null;
    const tooltip = document.getElementById("graph-tooltip");
    if (!canvas) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    let width = (canvas.width = canvas.parentElement?.clientWidth || 800);
    let height = (canvas.height = Math.max(500, window.innerHeight - 320));

    window.addEventListener("resize", () => {
      if (!canvas.parentElement) return;
      width = canvas.width = canvas.parentElement.clientWidth;
      height = canvas.height = Math.max(500, window.innerHeight - 320);
    });

    let data: GraphData = { nodes: [], links: [] };
    try {
      const res = await fetch("/data/notes_graph.json");
      data = await res.json();
    } catch (e) {
      console.error("Failed to load graph data", e);
      return;
    }

    const domainColors: Record<string, string> = {
      Engineering: "#3b82f6",
      "Mental Models": "#ff5500",
      "Linguistics & Learning": "#10b981",
      Economics: "#eab308",
    };

    const nodeRadius = 4.5;
    const nodes = data.nodes.map((n) => ({
      ...n,
      x: (Math.random() - 0.5) * (width * 0.6) + width / 2,
      y: (Math.random() - 0.5) * (height * 0.6) + height / 2,
      vx: 0,
      vy: 0,
      radius: nodeRadius,
    }));

    const nodeById = new Map<string, (typeof nodes)[0]>();
    for (const n of nodes) {
      nodeById.set(n.id, n);
    }

    const links = data.links
      .map((l) => {
        const s = typeof l.source === "string" ? nodeById.get(l.source) : l.source;
        const t = typeof l.target === "string" ? nodeById.get(l.target) : l.target;
        return { source: s, target: t };
      })
      .filter((l) => l.source && l.target);

    // Pan & Zoom state
    let transform = { x: 0, y: 0, scale: 1 };
    let isDragging = false;
    let dragStart = { x: 0, y: 0 };
    let hoveredNode: (typeof nodes)[0] | null = null;

    canvas.addEventListener("mousedown", (e) => {
      const rect = canvas.getBoundingClientRect();
      const mouseX = (e.clientX - rect.left - transform.x) / transform.scale;
      const mouseY = (e.clientY - rect.top - transform.y) / transform.scale;

      const hit = nodes.find(
        (n) => Math.hypot(n.x - mouseX, n.y - mouseY) <= n.radius + 3
      );

      if (hit) {
        window.location.href = hit.url;
        return;
      }

      isDragging = true;
      dragStart = { x: e.clientX - transform.x, y: e.clientY - transform.y };
    });

    window.addEventListener("mousemove", (e) => {
      const rect = canvas.getBoundingClientRect();
      if (isDragging) {
        transform.x = e.clientX - dragStart.x;
        transform.y = e.clientY - dragStart.y;
      } else {
        const mouseX = (e.clientX - rect.left - transform.x) / transform.scale;
        const mouseY = (e.clientY - rect.top - transform.y) / transform.scale;

        hoveredNode =
          nodes.find(
            (n) => Math.hypot(n.x - mouseX, n.y - mouseY) <= n.radius + 4
          ) || null;

        if (hoveredNode && tooltip) {
          canvas.style.cursor = "pointer";
          tooltip.style.display = "block";
          tooltip.style.left = `${e.clientX - rect.left + 15}px`;
          tooltip.style.top = `${e.clientY - rect.top + 10}px`;
          tooltip.innerHTML = `<strong>${hoveredNode.title}</strong><br/><span style="color:#888;">[${hoveredNode.domain}]</span>`;
        } else if (tooltip) {
          canvas.style.cursor = "default";
          tooltip.style.display = "none";
        }
      }
    });

    window.addEventListener("mouseup", () => {
      isDragging = false;
    });

    canvas.addEventListener("wheel", (e) => {
      e.preventDefault();
      const zoomFactor = e.deltaY < 0 ? 1.1 : 0.9;
      transform.scale = Math.min(Math.max(transform.scale * zoomFactor, 0.3), 3);
    });

    document.getElementById("zoom-in")?.addEventListener("click", () => {
      transform.scale = Math.min(transform.scale * 1.2, 3);
    });
    document.getElementById("zoom-out")?.addEventListener("click", () => {
      transform.scale = Math.max(transform.scale / 1.2, 0.3);
    });
    document.getElementById("reset-zoom")?.addEventListener("click", () => {
      transform = { x: 0, y: 0, scale: 1 };
    });

    // Simple Force Simulation
    function simulate() {
      // Repulsion between nodes
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[j].x - nodes[i].x;
          const dy = nodes[j].y - nodes[i].y;
          const dist = Math.hypot(dx, dy) || 1;
          if (dist < 150) {
            const force = (150 - dist) / dist * 0.04;
            nodes[i].vx -= dx * force;
            nodes[i].vy -= dy * force;
            nodes[j].vx += dx * force;
            nodes[j].vy += dy * force;
          }
        }
      }

      // Spring attraction on links
      for (const link of links) {
        if (!link.source || !link.target) continue;
        const dx = link.target.x - link.source.x;
        const dy = link.target.y - link.source.y;
        const dist = Math.hypot(dx, dy) || 1;
        const targetDist = 45;
        const force = (dist - targetDist) * 0.003;
        link.source.vx += dx * force;
        link.source.vy += dy * force;
        link.target.vx -= dx * force;
        link.target.vy -= dy * force;
      }

      // Center gravity & damping
      const cx = width / 2;
      const cy = height / 2;
      for (const n of nodes) {
        n.vx += (cx - n.x) * 0.0005;
        n.vy += (cy - n.y) * 0.0005;
        n.vx *= 0.9;
        n.vy *= 0.9;
        n.x += n.vx;
        n.y += n.vy;
      }
    }

    function render() {
      simulate();

      ctx.clearRect(0, 0, width, height);
      ctx.save();
      ctx.translate(transform.x, transform.y);
      ctx.scale(transform.scale, transform.scale);

      // Draw links
      ctx.strokeStyle = "rgba(255, 255, 255, 0.08)";
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (const link of links) {
        if (!link.source || !link.target) continue;
        ctx.moveTo(link.source.x, link.source.y);
        ctx.lineTo(link.target.x, link.target.y);
      }
      ctx.stroke();

      // Draw nodes
      for (const n of nodes) {
        const isHovered = n === hoveredNode;
        ctx.beginPath();
        ctx.arc(n.x, n.y, isHovered ? n.radius + 2 : n.radius, 0, 2 * Math.PI);
        ctx.fillStyle = domainColors[n.domain] || "#888888";
        ctx.fill();

        if (isHovered) {
          ctx.strokeStyle = "#ffffff";
          ctx.lineWidth = 1.5;
          ctx.stroke();
        }
      }

      ctx.restore();
      requestAnimationFrame(render);
    }

    render();
  }

  document.addEventListener("DOMContentLoaded", initGraph);
</script>

<style>
  .graph-page-container {
    max-width: 68rem;
    margin: 0 auto;
    font-family: "JetBrains Mono", Consolas, Menlo, monospace;
  }

  .breadcrumb-nav {
    margin-bottom: 1.5rem;
  }

  .back-link {
    color: var(--subheading-color, #888888);
    text-decoration: none;
    font-size: 0.85rem;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: #ff5500;
  }

  .graph-header {
    margin-bottom: 1.5rem;
  }

  .title-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .accent-bar {
    width: 4px;
    height: 1.85rem;
    background-color: #ff5500;
    border-radius: 2px;
  }

  .page-title {
    font-size: 1.85rem;
    font-weight: 700;
    color: var(--heading-color, #ffffff);
    margin: 0;
  }

  .tagline {
    color: var(--subheading-color, #888888);
    font-size: 0.92rem;
    line-height: 1.5;
    margin: 0.5rem 0 1rem 0;
  }

  .graph-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-size: 0.8rem;
    color: #aaaaaa;
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .legend-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .legend-dot.engineering {
    background-color: #3b82f6;
  }
  .legend-dot.mental-models {
    background-color: #ff5500;
  }
  .legend-dot.linguistics {
    background-color: #10b981;
  }
  .legend-dot.economics {
    background-color: #eab308;
  }

  .canvas-wrapper {
    position: relative;
    width: 100%;
    height: calc(100vh - 280px);
    min-height: 520px;
    background-color: #0d0e11;
    border: 1px solid #222225;
    border-radius: 6px;
    overflow: hidden;
  }

  #graph-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .graph-tooltip {
    position: absolute;
    display: none;
    pointer-events: none;
    background-color: #1a1a1f;
    border: 1px solid #333338;
    color: #ffffff;
    font-size: 0.78rem;
    padding: 0.4rem 0.65rem;
    border-radius: 4px;
    z-index: 10;
    line-height: 1.4;
  }

  .controls-overlay {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .controls-overlay button {
    background-color: #1a1a1f;
    border: 1px solid #333338;
    color: #dddddd;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.9rem;
    border-radius: 4px;
    transition: all 0.15s ease;
  }

  .controls-overlay button:hover {
    background-color: #26262d;
    color: #ff5500;
    border-color: #ff5500;
  }
</style>
