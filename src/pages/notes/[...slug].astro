---
import NoteLayout from "../../layouts/NoteLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  const paths: Array<{
    params: { slug: string };
    props: { note: (typeof notes)[number] };
  }> = [];

  for (const note of notes) {
    const rawId = note.id;
    // Generate route preserving exact case (e.g. /notes/Stack_vs_Heap_Memory_Fundamentals)
    paths.push({
      params: { slug: rawId },
      props: { note },
    });

    // Also support lowercase for tolerant web navigation
    const lowerId = rawId.toLowerCase();
    if (lowerId !== rawId) {
      paths.push({
        params: { slug: lowerId },
        props: { note },
      });
    }
  }

  return paths;
}

const { note } = Astro.props;
const { Content, headings } = await render(note);
---

<NoteLayout
  title={note.data.title}
  description={note.data.description}
  date={note.data.date}
  domain={note.data.domain}
  tags={note.data.tags}
  headings={headings}
>
  <Content />
</NoteLayout>
